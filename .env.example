# Copy to .env and fill in what you need.

# --- OpenAI (the default provider) ---
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.6-sol"
# Extra models to offer in the Details pane's model picker (comma-separated).
# OPENAI_MODELS="gpt-6.1-sol,gpt-5.6-luna,gpt-5.4-mini"
# Reasoning models route through the Responses API. Defaults to "medium";
# set to "" to stop requesting reasoning (and streamed reasoning summaries).
# REASONING_EFFORT="medium"

# --- Tools workspace: where read/write/edit/bash operate (default ./workspace) ---
# HUMPHREY_WORKSPACE="./workspace"

# --- Offline mock: no model calls, no credentials ---
# HUMPHREY_MOCK=1

# --- Session storage ---
# STORAGE_BACKEND="local"   # local (default) | memory | azure | auto
# LOCAL_STORAGE_DIR="./data"

# --- Optional Azure adapters (install with `uv sync --group azure`) ---
# Azure OpenAI is used only when OPENAI_API_KEY is unset. Auth is
# DefaultAzureCredential: az login, managed identity, or
# AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_CLIENT_SECRET.
# AZURE_OPENAI_ENDPOINT="https://<your-resource>.cognitiveservices.azure.com/"
# AZURE_OPENAI_DEPLOYMENT="gpt-5.6-sol"
# AZURE_OPENAI_API_VERSION="2024-10-21"
# Azure Blob session storage (with STORAGE_BACKEND="azure"):
# AZURE_STORAGE_ACCOUNT_URL="https://<account>.blob.core.windows.net/"
# AZURE_STORAGE_AI_LOGS_CONTAINER="ai-logs"
